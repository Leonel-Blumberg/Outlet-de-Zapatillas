# Copiar como .env.development.local y ajustar.

# true  -> el login funciona contra usuarios simulados en el navegador (sin backend)
# false -> el login usa la API ASP.NET real
VITE_USE_MOCK=true

# URL del backend ASP.NET al que el servidor de Vite redirige las llamadas a /api
VITE_API_PROXY_TARGET=http://localhost:5000

erDiagram
    SUCURSALES ||--o{ USUARIOS : "asigna (opcional)"
    SUCURSALES ||--o{ OBJETIVOS_VENTA : "tiene"
    SUCURSALES ||--o{ STOCK : "almacena"
    SUCURSALES ||--o{ VENTAS : "registra"
    MARCAS ||--o{ PRODUCTOS : "fabrica"
    CATEGORIAS ||--o{ PRODUCTOS : "clasifica"
    PRODUCTOS ||--o{ STOCK : "se guarda en"
    PRODUCTOS ||--o{ DETALLE_VENTAS : "se vende en"
    CLIENTES ||--o{ VENTAS : "realiza"
    VENTAS ||--|{ DETALLE_VENTAS : "contiene"

    USUARIOS {
        int id_usuario PK
        varchar nombre
        varchar apellido
        varchar email UK
        varchar password_hash
        varchar rol
        int id_sucursal FK "nullable"
        boolean activo
        timestamp fecha_alta
    }
    SUCURSALES {
        int id_sucursal PK
        varchar nombre UK
        varchar direccion
        varchar ciudad
        varchar provincia
        varchar telefono
        date fecha_apertura
    }
    OBJETIVOS_VENTA {
        int id_objetivo PK
        int id_sucursal FK
        smallint anio
        smallint mes
        numeric monto_objetivo
    }
    MARCAS {
        int id_marca PK
        varchar nombre UK
    }
    CATEGORIAS {
        int id_categoria PK
        varchar nombre UK
    }
    PRODUCTOS {
        int id_producto PK
        varchar sku UK
        varchar modelo
        int id_marca FK
        int id_categoria FK
        varchar genero
        numeric precio_lista
        numeric precio_outlet
        boolean activo
    }
    STOCK {
        int id_stock PK
        int id_sucursal FK
        int id_producto FK
        numeric talle
        int cantidad
        int stock_minimo
    }
    CLIENTES {
        int id_cliente PK
        varchar nombre
        varchar apellido
        varchar dni UK
        varchar email
        varchar telefono
        date fecha_alta
    }
    VENTAS {
        int id_venta PK
        varchar numero UK
        int id_sucursal FK
        int id_cliente FK
        timestamp fecha
        varchar medio_pago
        numeric total
    }
    DETALLE_VENTAS {
        int id_detalle PK
        int id_venta FK
        int id_producto FK
        numeric talle
        int cantidad
        numeric precio_unitario
        numeric subtotal
    }
